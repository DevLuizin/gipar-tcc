# =====================================================================
# Configurações de Ambiente para Docker - GIPAR
# =====================================================================

# Banco de Dados
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=gipar_db
MYSQL_USER=gipar_user
MYSQL_PASSWORD=gipar_password

# Backend (Segurança)
SECRET_KEY=chavesecretagipar2026segura

# Backend (SMTP - Opcional para envio de alertas)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Backend (CORS - Opcional, para permitir acessos diretos de outros domínios na porta 8000)
# Com o proxy reverso do Nginx (/api), as requisições normais do frontend não precisam de CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost

# Frontend (Usa o proxy reverso /api do Nginx, dispensando hardcode de IP ou portas)
VITE_API_URL=/api
